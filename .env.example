# ========================================================
# BrandSight AI - Environment Configuration
# ========================================================

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------
# AI Search Providers
# --------------------------------------------------------
# 1. OpenAI (Default model: gpt-4o-mini for cost control)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Google Gemini (Model: gemini-1.5-flash / gemini-2.0-flash free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. DeepSeek (Model: deepseek-chat; server-side only. If empty, marked 'Coming Soon' in UI)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --------------------------------------------------------
# Supabase Configuration (Database & Auth)
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --------------------------------------------------------
# Lemon Squeezy (Freemium & License Keys)
# --------------------------------------------------------
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# Lemon Squeezy Variant / Checkout URLs
NEXT_PUBLIC_LEMON_PRO_CHECKOUT_URL=https://yourstore.lemonsqueezy.com/buy/pro-variant-id
NEXT_PUBLIC_LEMON_AGENCY_CHECKOUT_URL=https://yourstore.lemonsqueezy.com/buy/agency-variant-id

# --------------------------------------------------------
# Email Reports (Weekly Summary)
# --------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
REPORT_FROM_EMAIL=reports@brandsight.ai

# --------------------------------------------------------
# Cron Job & Cost Guardrails
# --------------------------------------------------------
CRON_SECRET=brandsight_secure_cron_token_12345
CACHE_TTL_HOURS=24
